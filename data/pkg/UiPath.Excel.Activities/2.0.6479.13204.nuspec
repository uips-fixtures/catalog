<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Excel.Activities</id>
    <version>2.0.6479.13204</version>
    <title>UiPath.Excel.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://activities.uipath.com/docs/excel</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>Execute Excel related operations using the Open Office XML format (XLSX) or Excel.Interop</description>
    <releaseNotes>Fix Excel Application activities failing if the workbook contained Charts 
Fix Workbook Get Table Range for Pivot tables throwing exception
Fix Workbook Read Range 'too many parameters' error
Fix Workbook Read Range 'Expression expected' error
Add Headers option for Read Range is set to true by default</releaseNotes>
    <dependencies>
      <dependency id="ClosedXML" version="0.87.1" />
      <dependency id="CsvHelper" version="2.13.5" />
      <dependency id="DocumentFormat.OpenXml" version="2.5.0" />
      <dependency id="NPOI" version="2.2.1" />
    </dependencies>
  </metadata>
</package>