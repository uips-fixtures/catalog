<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Excel.Activities</id>
    <version>2.4.7649.24968</version>
    <title>UiPath.Excel.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/v1.0/docs/about-the-excel-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>IMPORTANT: This package version must be upgraded to a version greater than or equal to 2.9.3.
———————————
Execute Excel related operations using the Open Office XML format (XLSX) or Excel.Interop.</description>
    <releaseNotes>Bug Fixes

Opening password protected files created with Microsoft Excel 2010 threw an error when using the Workbook Activities from the Excel Activities package.

Fixed an issue which prevented using Excel methods from the Workbook field in Excel Application Scope.</releaseNotes>
    <dependencies>
      <dependency id="ClosedXML" version="0.87.1" />
      <dependency id="CsvHelper" version="2.13.5" />
      <dependency id="DocumentFormat.OpenXml" version="2.5.0" />
      <dependency id="Microsoft.VisualStudio.OLE.Interop" version="7.10.6071" />
      <dependency id="NPOI" version="2.2.1" />
    </dependencies>
  </metadata>
</package>