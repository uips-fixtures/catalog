<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Excel.Activities</id>
    <version>2.6.1</version>
    <title>UiPath.Excel.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/v1.0/docs/about-the-excel-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>Execute Excel related operations using the Open Office XML format (XLSX) or Excel.Interop</description>
    <releaseNotes>Bug Fixes

* When trying to edit a read-only Excel file and save changes, the newly generated file was saved at a different location than the original one. The fix saves the new file correctly and also throws an exception notifying the fact that the original file could not be saved.

For the full release notes, please visit https://activities.uipath.com/docs/release-notes-excel</releaseNotes>
    <dependencies>
      <dependency id="ClosedXML" version="0.87.1" />
      <dependency id="CsvHelper" version="2.13.5" />
      <dependency id="DocumentFormat.OpenXml" version="2.5.0" />
      <dependency id="Microsoft.VisualStudio.OLE.Interop" version="7.10.6071" />
      <dependency id="NPOI" version="2.4.1" />
      <dependency id="SharpZipLib" version="1.0.0" />
    </dependencies>
  </metadata>
</package>