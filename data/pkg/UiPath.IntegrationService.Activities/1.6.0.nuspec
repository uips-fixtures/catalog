<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.IntegrationService.Activities</id>
    <version>1.6.0</version>
    <title>Integration Service Activities</title>
    <authors>UiPath</authors>
    <icon>uipath_logo.png</icon>
    <description>This Activity Pack is used to serve all activities for any connector from Integration Service's rich catalog. There is no need to manually install this package. Studio automatically installs and updates the package whenever a connector activity is dragged on the canvas. This package is designed so it maintains backwards compatibility at all times. You require Integration Service in Automation Cloud and Studio &gt; 23.10 in order to use this.</description>
    <tags>Integration Service, Connectors, Catalog, API, UiPathActivities</tags>
    <repository type="git" commit="60770252e3428260186081b14bbfab4eb22cc0c7" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Microsoft.Extensions.DependencyInjection" version="7.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Http" version="7.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Http.Polly" version="7.0.5" exclude="Build,Analyzers" />
        <dependency id="Nito.AsyncEx.Coordination" version="5.1.2" exclude="Build,Analyzers" />
        <dependency id="Polly.Contrib.WaitAndRetry" version="1.1.1" exclude="Build,Analyzers" />
        <dependency id="System.Activities.ViewModels" version="1.0.0-20231115.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.ConnectionClient" version="1.4.5" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="24.10.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="2.0.41" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>