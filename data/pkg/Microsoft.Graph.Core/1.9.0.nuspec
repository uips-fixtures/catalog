<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
    <metadata>
        <id>Microsoft.Graph.Core</id>
        <version>1.9.0</version>
        <authors>Microsoft</authors>
        <owners>Microsoft</owners>
        <licenseUrl>http://aka.ms/devservicesagreement</licenseUrl>
        <projectUrl>https://developer.microsoft.com/graph</projectUrl>
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <description>Microsoft Graph Core Client Library implements core functionality used by Microsoft Graph Client Libraries.</description>
        <releaseNotes>May 2018 Release Summary (version 1.9.0)

New features
- Added more comments.
- Added response headers and status to all calls that return a non-stream object.
- Added SerializeObject method to MockSerializer.</releaseNotes>
        <copyright>Copyright (c) Microsoft Corporation</copyright>
        <tags>Microsoft Office365 Graph GraphServiceClient Outlook OneDrive AzureAD GraphAPI Productivity SharePoint Intune SDK</tags>
        <dependencies>
            <group targetFramework=".NETFramework4.5">
                <dependency id="Newtonsoft.Json" version="[6.0.1, 12.0.0)" exclude="Build,Analyzers" />
            </group>
            <group targetFramework=".NETStandard1.1">
                <dependency id="NETStandard.Library" version="1.6.0" exclude="Build,Analyzers" />
                <dependency id="Newtonsoft.Json" version="[9.0.1, 12.0.0)" exclude="Build,Analyzers" />
            </group>
        </dependencies>
        <frameworkAssemblies>
            <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.5" />
            <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.5" />
            <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.5" />
        </frameworkAssemblies>
    </metadata>
</package>