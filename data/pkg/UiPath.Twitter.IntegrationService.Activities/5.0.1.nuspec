<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Twitter.IntegrationService.Activities</id>
    <version>5.0.1</version>
    <title>Twitter</title>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-twitter-twitter-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. UiPath Integration Service based automation activities for Twitter. These activities allow you to execute create, retrieve, update, delete and invoke operations on Twitter.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities twitter tweet messaging integration service connector catalog</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>