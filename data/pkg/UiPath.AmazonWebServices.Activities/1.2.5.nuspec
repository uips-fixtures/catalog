<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.AmazonWebServices.Activities</id>
    <version>1.2.5</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-the-amazonwebservices-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Amazon Web Services Activities Pack</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities AWS Amazon AmazonWebServices Cloud S3 EC2 VM VirtualMachine Instance Bucket Object</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="AWSSDK.Core" version="3.3.104.1" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.EC2" version="3.3.142.1" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.Extensions.NETCore.Setup" version="3.3.100.1" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.S3" version="3.3.109.1" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.SimpleSystemsManagement" version="3.3.100.8" exclude="Build,Analyzers" />
        <dependency id="Amazon.Extensions.Configuration.SystemsManager" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="Polly" version="7.2.0" exclude="Build,Analyzers" />
        <dependency id="Polly.Contrib.WaitAndRetry" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel.Annotations" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Data.DataSetExtensions" version="4.5.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.3.18" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data.DataSetExtensions" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>