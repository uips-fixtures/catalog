<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DocXCore</id>
    <version>1.0.9</version>
    <authors>Catahl Coffey</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>http://docx.codeplex.com/license</licenseUrl>
    <projectUrl>http://docx.codeplex.com/</projectUrl>
    <iconUrl>http://download.codeplex.com/Project/Download/FileDownload.aspx?ProjectName=docx&amp;amp;DownloadId=83756&amp;amp;Build=17950</iconUrl>
    <description>DocX is a .NET library that allows developers to manipulate Word 2007 files, in an easy and intuitive manor. This is a fork of DocX for .NET Core.</description>
    <releaseNotes>Updated for .NET Core to 2.0</releaseNotes>
    <tags>Word DocX</tags>
