<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.PDF.Activities</id>
    <version>2.1.0</version>
    <title>UiPath.PDF.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-pdf-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>IMPORTANT: This package version requires Studio v2018.4.4 / v2019.2 or above. Installing it on versions lower than the recommended ones may cause unexpected changes in your workflows.
PDF/XPS Activities Pack.</description>
    <releaseNotes>New Features and Improvements

* Range field properties have been updated for the following activities: Read XPS Text, Read PDF Text and Read PDF Text with OCR.
* When using the Export PDF Page As Image activity, you only had the option of opening a .pdf file when browsing it from the Output field. Now you can save a .pdf file as an image directly by browsing for it straight from the activity.


For the complete release notes, please visit https://activities.uipath.com/docs/release-notes-pdf.</releaseNotes>
    <dependencies>
      <dependency id="UiPath.OCR.Contracts" version="1.0.0" />
      <dependency id="System.ValueTuple" version="4.5.0" />
      <dependency id="BitMiracle.Docotic.Pdf" version="5.2.8369" />
    </dependencies>
  </metadata>
</package>