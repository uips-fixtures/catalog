        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="System.ServiceModel.Duplex" version="4.10.0" exclude="Build,Analyzers" />
