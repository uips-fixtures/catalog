<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RadCommons.core</id>
    <version>2.0.1</version>
    <authors>Radek Adamec</authors>
    <owners>Radek Adamec</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/adamecr/Commons/blob/master/license.txt</licenseUrl>
    <projectUrl>https://github.com/adamecr/Commons</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/adamecr/Commons/master/icon.png</iconUrl>
    <description>Library of common helpers, utilities and extensions</description>
    <copyright>Radek Adamec 2019</copyright>
    <repository type="git" url="https://github.com/adamecr/Commons.git" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="NLog" version="4.6.5" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="12.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>