    <iconUrl>https://download.uipath.com/UI_icon.png?powerPoint</iconUrl>
    <description>A set of activities for interacting with presentation applications (e.g. PowerPoint).</description>
    <releaseNotes>https://docs.uipath.com/releasenotes/docs/uipath-presentations-activities</releaseNotes>
    <copyright>© UiPath</copyright>
