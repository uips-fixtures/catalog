        <dependency id="DocumentFormat.OpenXml" version="2.5.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.VisualStudio.OLE.Interop" version="7.10.6071" exclude="Build,Analyzers" />
        <dependency id="SharpZipLib" version="1.0.0" exclude="Build,Analyzers" />
