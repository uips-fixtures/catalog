<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Nito.Cancellation</id>
    <version>1.0.5</version>
    <authors>Stephen Cleary</authors>
    <owners>Stephen Cleary</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://raw.githubusercontent.com/StephenCleary/Cancellation/master/LICENSE</licenseUrl>
    <projectUrl>https://github.com/StephenCleary/Cancellation</projectUrl>
    <description>Helper types for working with cancellation tokens and sources.</description>
    <tags>cancellation cancellationtoken</tags>
    <repository type="git" url="https://github.com/StephenCleary/Cancellation.git" />
    <dependencies>
      <group targetFramework=".NETStandard1.0">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="Nito.Disposables" version="1.2.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Nito.Disposables" version="1.2.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>