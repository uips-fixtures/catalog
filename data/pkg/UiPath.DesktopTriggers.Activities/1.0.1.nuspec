<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.DesktopTriggers.Activities</id>
    <version>1.0.1</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-the-desktop-triggers-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Monitors system or application specific performance (CPU, Memory, Disk)/resource utilization to perform actions based on designated resource consumption thresholds</description>
    <tags>UiPathActivities,Triggers,Performance</tags>
    <dependencies>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="System.Diagnostics.PerformanceCounter" version="5.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>