<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.WorkflowEvents.Activities</id>
    <version>1.0.0</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?system</iconUrl>
    <description>IMPORTANT: This package requires Studio 2022.4 or above. The Interim Process Results activity won’t work on a lower version. An activity that allows you to send the results of an Attended Job to a UiPath App, or a custom app using Robot.js, before it has finished executing.</description>
    <copyright>© UiPath</copyright>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>