<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MobileAutomation.Activities</id>
    <version>23.10.0-preview</version>
    <title>UiPath.MobileAutomation.Activities</title>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-mobile-automation-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?mobileautomation</iconUrl>
    <description>IMPORTANT: This package version requires Studio v2020.4 or above. Installing it on versions lower than the recommended ones may cause unexpected behavior.
    Mobile activities which enable users to automate mobile devices running Android or iOS, using a local or remote Appium server. The package includes activities for performing UI operations, pressing hardware buttons, managing applications, capturing device screenshots, retrieving logs, and more.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <repository type="git" commit="ce79b3a096177b0a35ad7506f44cae1f0eff0f5e" />
    <dependencies>
