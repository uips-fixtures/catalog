      <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Runtime.Serialization" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Windows.Forms" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xaml" targetFramework=".NETFramework4.6.1" />
