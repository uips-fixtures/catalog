        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="System.Activities.ViewModels" version="1.0.0-20230306.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
