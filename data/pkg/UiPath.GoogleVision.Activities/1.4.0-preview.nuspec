<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.GoogleVision.Activities</id>
    <version>1.4.0-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/google-vision-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Package containing different integrations with Google Vision.</description>
    <releaseNotes>Localized in Chinese, French, German, Japanese, Korean, Portuguese (Brazilian), Russian. Icons standardized.</releaseNotes>
    <copyright>© UiPath</copyright>
    <tags>UiPath Google Vision ML AI Image</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.84" exclude="Build,Analyzers" />
        <dependency id="Google.Apis" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Auth" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Core" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Oauth2.v2" version="1.51.0.1869" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Vision.v1" version="1.51.0.2304" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="Google.Apis" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Auth" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Core" version="1.51.0" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Oauth2.v2" version="1.51.0.1869" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Vision.v1" version="1.51.0.2304" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net6.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework=".NETFramework4.6.1" />
    </frameworkReferences>
  </metadata>
