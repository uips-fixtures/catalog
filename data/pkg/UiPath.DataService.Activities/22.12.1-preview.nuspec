<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.DataService.Activities</id>
    <version>22.12.1-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?system</iconUrl>
    <description>IMPORTANT: This package version is currently labeled as preview and shouldn't be used in production environments as expected behaviors might be unstable. Please note, it is recommended for cross-platform projects not to upgrade to the latest version of Studio (22.10) if using data service activities as there are breaking changes to previous versions of data service activities.
Core activities (which enable the robots to manipulate data stored in UiPath Data Service) allow you to execute operations such as create, update, read, search or delete on records stored in Data Service Entities.</description>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework="net5.0">
        <dependency id="System.Activities.ViewModels" version="1.0.0-20220712.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0" />
    </dependencies>
  </metadata>
</package>