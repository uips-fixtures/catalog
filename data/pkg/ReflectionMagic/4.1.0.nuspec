<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ReflectionMagic</id>
    <version>4.1.0</version>
    <authors>David Ebbo</authors>
    <owners>David Ebbo</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://www.apache.org/licenses/LICENSE-2.0</licenseUrl>
    <projectUrl>https://github.com/davidebbo/ReflectionMagic</projectUrl>
    <description>Framework to drastically simplify your private reflection code using C# dynamic</description>
    <tags>dynamic</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="System.Reflection" version="4.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard1.5">
        <dependency id="Microsoft.CSharp" version="4.4.1" exclude="Build,Analyzers" />
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.CSharp" version="4.4.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.5" />
    </frameworkAssemblies>
  </metadata>
</package>