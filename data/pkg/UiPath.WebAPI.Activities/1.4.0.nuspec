  <metadata>
    <id>UiPath.WebAPI.Activities</id>
    <version>1.4.0</version>
    <title>UiPath.Web.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-web-activities-pack</projectUrl>
