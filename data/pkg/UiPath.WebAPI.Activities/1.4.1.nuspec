<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.WebAPI.Activities</id>
    <version>1.4.1</version>
    <title>UiPath.Web.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-web-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>JSON, REST, SOAP, XML</description>
    <releaseNotes>* Fixed an issue which caused headers with certain names to be wrongly identified by the HTTP Request activity.
* The HTTP Request activity did not display parameters edited with the wizard in the Properties panel.

For the full release notes, please visit https://activities.uipath.com/docs/release-notes-web.</releaseNotes>
    <dependencies>
      <dependency id="AvalonEdit" version="5.0.3" />
      <dependency id="Newtonsoft.Json" version="11.0.2" />
      <dependency id="RestSharp" version="106.3.1" />
    </dependencies>
  </metadata>
</package>