<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.WebAPI.Activities</id>
    <version>1.8.0-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://activities.uipath.com/docs/about-the-web-activities-pack</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?web</iconUrl>
    <description>JSON, REST, SOAP, XML</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="AvalonEdit" version="6.0.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CSharp" version="4.5.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="RestSharp" version="106.3.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="Microsoft.CSharp" version="4.5.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="RestSharp" version="106.3.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="AvalonEdit" version="6.0.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CSharp" version="4.5.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="RestSharp" version="106.3.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>