<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Mail.Activities</id>
    <version>1.10.3-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-mail-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?mail</iconUrl>
    <description>Retrieve and send mail using POP3, IMAP, SMTP and Exchange protocols</description>
    <releaseNotes>https://docs.uipath.com/releasenotes/docs/uipath-mail-activities</releaseNotes>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Activities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Google.Apis.Calendar.v3" version="1.43.0.1872" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Gmail.v1" version="1.43.0.1859" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.PeopleService.v1" version="1.43.0.1876" exclude="Build,Analyzers" />
        <dependency id="MailKit" version="2.10.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Exchange.WebServices" version="2.2.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.FileSystemGlobbing" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client" version="4.14.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="11.0.1" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>