<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Mail.Activities</id>
    <version>1.3.0</version>
    <title>UiPath.Mail.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-mail-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>Retrieve and send mail using POP3, IMAP, SMTP and Exchange protocols</description>
    <releaseNotes>This new year brings two more languages in the entire UiPath Platform - French and Russian. Since we layed down the foundations of localization in our previous release, we are continuing our efforts in bringing you a more immersive experience and lowering the language barrier bit by bit.</releaseNotes>
    <dependencies>
      <dependency id="Microsoft.Exchange.WebServices" version="2.2.0" />
      <dependency id="BouncyCastle" version="1.8.1" />
    </dependencies>
  </metadata>
</package>