      <group targetFramework=".NETStandard2.0">
        <dependency id="AWSSDK.AppConfig" version="3.7.0.52" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.Extensions.NETCore.Setup" version="3.7.1" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.SimpleSystemsManagement" version="3.7.4.11" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration" version="2.0.2" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="12.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
