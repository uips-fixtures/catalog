<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Amazon.Extensions.Configuration.SystemsManager</id>
    <version>3.0.0</version>
    <title>.NET Configuration Extensions for AWS Systems Manager</title>
    <authors>Amazon Web Services</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>icon.png</icon>
    <projectUrl>https://github.com/aws/aws-dotnet-extensions-configuration/</projectUrl>
    <description>.NET Configuration Extensions for AWS Systems Manager</description>
    <copyright>2018-2021</copyright>
    <tags>AWS Amazon aws-sdk-v3 SimpleSystemsManagement configuration</tags>
