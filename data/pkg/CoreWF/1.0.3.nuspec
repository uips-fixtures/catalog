<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>CoreWf</id>
    <version>1.0.3</version>
    <title>Core WF</title>
    <authors>Dustin Metzgar,Jim Carley</authors>
    <owners>Dustin Metzgar,Jim Carley</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/dmetzgar/corewf</projectUrl>
    <iconUrl>https://dmsignalrtest.blob.core.windows.net/blogimages/CoreWf.svg</iconUrl>
    <description>Unofficial port of the Windows Workflow Foundation (WF) to the .NET Standard</description>
    <copyright>Copyright © Dustin Metzgar 2017</copyright>
    <tags>.NET Core workflow</tags>
    <dependencies>
      <group targetFramework=".NETStandard1.3">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel.EventBasedAsync" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.TypeExtensions" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.Serialization.Primitives" version="4.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>