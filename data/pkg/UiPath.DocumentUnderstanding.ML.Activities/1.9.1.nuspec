<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.DocumentUnderstanding.ML.Activities</id>
    <version>1.9.1</version>
    <title>UiPath.DocumentUnderstanding.ML.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-documentunderstanding-ml-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/DU_icon.png?documentunderstanding-ml</iconUrl>
    <description>Activity package that enables Machine Learning Document Understanding features, such as the Machine Learning Extractor and the Machine Learning Classifier. This package requires a UiPath Studio and Robot version 2019.10 or above, and access to AI Fabric, for using custom ML models through ML Skills.</description>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="UiPath.DocumentProcessing.Contracts" version="1.11.0" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="2.3.21" />
        <dependency id="Newtonsoft.Json" version="11.0.2" />
        <dependency id="BitMiracle.Docotic.Pdf" version="7.5.11645" />
        <dependency id="Polly" version="7.1.0" />
        <dependency id="System.Collections.Immutable" version="1.5.0" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="UiPath.DocumentProcessing.Contracts" version="1.11.0" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="2.3.21" />
        <dependency id="Newtonsoft.Json" version="11.0.2" />
        <dependency id="BitMiracle.Docotic.Pdf" version="7.5.11645" />
        <dependency id="Polly" version="7.1.0" />
        <dependency id="System.Collections.Immutable" version="1.5.0" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" />
      </group>
    </dependencies>
  </metadata>
</package>