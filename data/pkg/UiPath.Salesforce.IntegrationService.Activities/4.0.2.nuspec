<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Salesforce.IntegrationService.Activities</id>
    <version>4.0.2</version>
    <title>Salesforce</title>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-salesforce-sfdc-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. UiPath Integration Service based automation activities for Salesforce using Salesforce Lightning Platform API. These activities allow you to execute create, retrieve, update, and delete operations on Salesforce objects (including standard and custom objects).</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Salesforce CRM</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" exclude="Build,Analyzers" />
        <dependency id="UiPath.ConnectionClient" version="1.3.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="UiPath.ConnectionClient" version="1.3.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" exclude="Build,Analyzers" />
        <dependency id="UiPath.ConnectionClient" version="1.3.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="1.0.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.ComponentModel.DataAnnotations" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>