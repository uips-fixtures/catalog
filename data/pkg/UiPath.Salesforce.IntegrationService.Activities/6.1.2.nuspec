<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Salesforce.IntegrationService.Activities</id>
    <version>6.1.2</version>
    <title>Salesforce</title>
    <authors>UiPath</authors>
    <owners></owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-salesforce-sfdc-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>This package is deprecated as of Studio 23.10. 
Integration Service Connectors can now be used directly from the Project's Activities panel or Package Manager under All Connectors.

THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. UiPath Integration Service based automation activities for Salesforce using Salesforce Lightning Platform API. These activities allow you to execute create, retrieve, update, and delete operations on Salesforce objects (including standard and custom objects).</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Salesforce CRM</tags>
