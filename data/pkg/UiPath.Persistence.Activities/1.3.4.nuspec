<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Persistence.Activities</id>
    <version>1.3.4</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-the-persistence-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>This activity pack contains long running activities that enables to build orchestration process by chaining various RPA workflows through Orchestrator Queues and Start Job, as well as inject human tasks during workflow execution.
This pack contains activities that persists the workflow context in a central persistence store so that workflows can wait for long running activities to complete without blocking resources (Robots and Human).
Tasks created through this activity pack will be presented in Actions space for end users.

IMPORTANT : Certain new features added to this package version requires Orchestrator v2021.10 or above. Other pre-requisites would be Studio v2019.10 or above and UiPath.FormActivityLibrary 1.0.2 or above.
Installing it on versions lower than the recommended ones may create un-expected results during execution.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Persistence Actions Tasks ActionCenter OrchestrationProcess LongRunningWorkflows</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Microsoft.Rest.ClientRuntime" version="2.3.23" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.FormActivityLibrary.Contracts" version="1.9.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="Microsoft.Rest.ClientRuntime" version="2.3.23" exclude="Build,Analyzers" />
        <dependency id="UiPath.FormActivityLibrary.Contracts" version="1.9.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="Microsoft.Rest.ClientRuntime" version="2.3.23" exclude="Build,Analyzers" />
        <dependency id="UiPath.FormActivityLibrary.Contracts" version="1.9.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>