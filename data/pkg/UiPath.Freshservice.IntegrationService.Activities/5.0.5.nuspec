        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>