<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Jira.Activities</id>
    <version>2.1.0-preview</version>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/integrations/docs/how-to-create-activities</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>An activity package for interacting with Atlassian Jira</description>
    <releaseNotes>Initial Release</releaseNotes>
    <copyright>© 2020 UiPath</copyright>
    <tags>UiPath Activit𝗒 Atlassian Jira Project Management Bug Tracking</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Atlassian.SDK" version="12.1.1" exclude="Build,Analyzers" />
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.84" exclude="Build,Analyzers" />
        <dependency id="System.Security.Permissions" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="20.4.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.2.20" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="PresentationFramework" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Core.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Core" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data.DataSetExtensions" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xml" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xml.Linq" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>