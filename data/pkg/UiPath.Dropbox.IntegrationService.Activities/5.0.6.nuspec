  <metadata>
    <id>UiPath.Dropbox.IntegrationService.Activities</id>
    <version>5.0.6</version>
    <title>Dropbox</title>
    <authors>UiPath</authors>
    <owners></owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-dropbox-dropbox-about</projectUrl>
