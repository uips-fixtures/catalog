<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NPOI</id>
    <version>2.5.6</version>
    <title>NPOI</title>
    <authors>NPOI Contributors</authors>
    <owners>Nissl Lab</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>logo\60_60.jpg</icon>
    <projectUrl>https://github.com/nissl-lab/npoi</projectUrl>
    <description>.NET port of Apache POI | Contact us on telegram: https://t.me/npoidevs</description>
    <summary>NPOI can read and write xls (Excel 97-2003), xlsx(Excel 2007+) and docx(Word 2007+)</summary>
    <releaseNotes>https://github.com/nissl-lab/npoi/discussions/819</releaseNotes>
    <copyright>Nissl LLC</copyright>
    <tags>xlsx xls Excel Word docx office ole</tags>
    <repository type="git" url="https://github.com/nissl-lab/npoi" branch="release2.5.6" commit="5b864945b1c54b3421d256ee7424209958ebade4" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Configuration.ConfigurationManager" version="4.5.0" />
        <dependency id="System.Drawing.Common" version="4.5.0" />
        <dependency id="SharpZipLib" version="1.3.3" />
        <dependency id="Portable.BouncyCastle" version="1.8.9" />
      </group>
      <group targetFramework=".NETFramework4.5">
        <dependency id="SharpZipLib" version="1.3.3" />
        <dependency id="Portable.BouncyCastle" version="1.8.9" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="System.Configuration.ConfigurationManager" version="4.5.0" />
        <dependency id="System.Drawing.Common" version="4.5.0" />
        <dependency id="SharpZipLib" version="1.3.3" />
        <dependency id="Portable.BouncyCastle" version="1.8.9" />
      </group>
    </dependencies>
  </metadata>
</package>