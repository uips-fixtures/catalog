<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Microsoft.Rest.ClientRuntime.Azure.Authentication</id>
    <version>2.4.1</version>
    <authors>Microsoft</authors>
    <owners>Microsoft</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://raw.githubusercontent.com/Microsoft/dotnet/master/LICENSE</licenseUrl>
    <projectUrl>https://github.com/Azure/azure-sdk-for-net</projectUrl>
    <iconUrl>http://go.microsoft.com/fwlink/?LinkID=288890</iconUrl>
    <description>Provides ADAL based authentication for Azure management client libraries</description>
    <releaseNotes>Fixes:
        - Relaxed the upped bound for Microsoft.IdentityModel.* dependencies.</releaseNotes>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <tags>Microsoft AutoRest ClientRuntime Authentication</tags>
    <repository url="https://github.com/Azure/azure-sdk-for-net" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Tokens" version="5.1.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="[2.3.20, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="10.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.5.2">
        <dependency id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="[2.28.3]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="[2.3.20, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="6.0.8" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard1.4">
        <dependency id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Tokens" version="5.1.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="[2.3.20, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="10.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IdentityModel.Tokens" version="5.1.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Rest.ClientRuntime" version="[2.3.20, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="10.0.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>