<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.OCR.Activities</id>
    <version>3.4.0-preview</version>
    <title>UiPath.OCR.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-the-uipath-ocr-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?ocr-activities</iconUrl>
    <description>The UiPath.OCR.Activities package contains the "UiPath Screen OCR" and "UiPath Document OCR" activities, that use UiPath's OCR engines.</description>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="UiPath.OCR.Contracts" version="2.10.0-preview" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="UiPath.OCR.Contracts" version="2.10.0-preview" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="UiPath.OCR.Contracts" version="2.10.0-preview" />
      </group>
    </dependencies>
  </metadata>
</package>