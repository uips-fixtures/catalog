<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.ServiceNow.Activities</id>
    <version>1.3.3-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/servicenow-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for ServiceNow using the ServiceNow API. These activities allow you to execute operations such as create, retrieve, update, and delete on ServiceNow objects (including Standard and Custom objects), manage file attachments, and to search for records of a specific type using a ServiceNow query.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
