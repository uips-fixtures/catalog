<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.SAP.BAPI.Activities</id>
    <version>2.2.2</version>
    <title>UiPath.SAP.BAPI.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-sap-bapi-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?sap-bapi</iconUrl>
    <description>Activities to automate invocation of SAP BAPI in SAP ECC and SAP S/4HANA. These activities use the SAP .NET Connector to establish a connection to SAP system and invoke the SAP BAPI. The Configuration Wizard simplifies the task of finding, configuring, and mapping the parameters of the SAP BAPI.</description>
    <releaseNotes>Bug Fixes

* Invoking a BAPI with return parameters named differently than RETURN threw an exception.

For the full release notes, please visit https://activities.uipath.com/docs/release-notes-sap-bapi.</releaseNotes>
    <dependencies>
      <dependency id="ClosedXML" version="0.87.1" />
      <dependency id="DocumentFormat.OpenXml" version="2.5.0" />
    </dependencies>
  </metadata>
</package>