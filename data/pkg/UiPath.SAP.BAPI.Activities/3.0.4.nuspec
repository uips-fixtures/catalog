      <group targetFramework=".NETFramework4.6.1">
        <dependency id="CsvHelper" version="16.0.0" exclude="Build,Analyzers" />
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.84" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="CsvHelper" version="16.0.0" exclude="Build,Analyzers" />
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.84" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework=".NETFramework4.6.1" />
    </frameworkReferences>
  </metadata>
</package>