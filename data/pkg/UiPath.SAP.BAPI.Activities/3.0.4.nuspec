<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.SAP.BAPI.Activities</id>
    <version>3.0.4</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/other/latest/legacy-integrations/about-the-sap-bapi-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for SAP BAPI. 
			
PLEASE NOTE THAT THIS VERSION OF 3.0.0 PACKAGE (OR ABOVE) CAN ONLY BE USED IN STUDIO VERSIONS, EQUAL OR HIGHER THAN 24.10.
			
Activities to automate invocation of SAP BAPI in SAP ECC and SAP S/4HANA. These activities use the SAP .NET Connector to establish a connection to SAP system and invoke the SAP BAPI. The Configuration Wizard simplifies the task of finding, configuring, and mapping the parameters of the SAP BAPI. Please refer to the link below for Studio version compatibility and support: https://www.uipath.com/legal/trust-and-security/legal-support/product-lifecycle.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <repository type="git" commit="c246b28c57539db69cea1f724da7bf55ca8b0086" />
