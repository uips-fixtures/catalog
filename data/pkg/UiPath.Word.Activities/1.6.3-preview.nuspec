<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Word.Activities</id>
    <version>1.6.3-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/v1.0/docs/about-the-word-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?word</iconUrl>
    <description>A set of activities for interacting with Microsoft Word.</description>
    <releaseNotes>https://docs.uipath.com/releasenotes/docs/uipath-word-activities</releaseNotes>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Activities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="DocXCore" version="1.0.9" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Presentation" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>