<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Word.Activities</id>
    <version>1.13.0</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/v1.0/docs/about-the-word-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?word</iconUrl>
    <description>A set of activities for interacting with Microsoft Word.</description>
    <releaseNotes>https://docs.uipath.com/releasenotes/docs/uipath-word-activities</releaseNotes>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Activities UiPathStudioX</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
        <dependency id="Xceed.Words.NET" version="2.0.21359.11160" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="Xceed.Words.NET" version="2.0.21359.11160" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="System.Drawing.Common" version="5.0.3" exclude="Build,Analyzers" />
        <dependency id="Xceed.Words.NET" version="2.0.21359.11160" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>