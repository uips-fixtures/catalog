<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.GSuite.Activities</id>
    <version>1.6.0-preview.1</version>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-google-gsuite-activities</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>A set of activities for interacting with Google GSuite.</description>
    <releaseNotes>Add encryption at rest for stored credentials. Add support for UiPath IDP when using Orchestrator to store credentials.</releaseNotes>
    <tags>UiPath GSuite Drive Gmail Sheets Calendar Docs AppsScript</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Google.Apis.Calendar.v3" version="1.43.0.1872" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Docs.v1" version="1.43.0.1869" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Drive.v3" version="1.43.0.1863" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Gmail.v1" version="1.43.0.1859" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Script.v1" version="1.43.0.1871" exclude="Build,Analyzers" />
        <dependency id="Google.Apis.Sheets.v4" version="1.43.0.1867" exclude="Build,Analyzers" />
        <dependency id="Microsoft.ApplicationInsights" version="2.3.0" exclude="Build,Analyzers" />
        <dependency id="MimeKit" version="2.5.1" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="11.0.1" exclude="Build,Analyzers" />
        <dependency id="NodaTime" version="2.4.7" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="PresentationCore" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="PresentationFramework" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Core.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.DurableInstancing" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Core" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data.DataSetExtensions" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Drawing" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Windows.Forms" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Workflow.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xaml" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xml" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xml.Linq" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="UIAutomationProvider" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="WindowsBase" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>