      <dependency id="MimeKit" version="2.1.4" />
      <dependency id="BouncyCastle" version="1.8.5" />
      <dependency id="Newtonsoft.Json" version="10.0.3" />
      <dependency id="NodaTime" version="2.4.5" />
    </dependencies>
  </metadata>
</package>