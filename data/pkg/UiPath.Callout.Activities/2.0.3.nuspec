<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Callout.Activities</id>
    <version>2.0.3</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/form-activity</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Design and build contextual guidance to users through callouts using a drag and drop interface, binding callout fields to workflow variables. The creation of a callout generates JSON schema that is used to display the same at runtime.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="System.IO.Abstractions" version="3.0.10" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.7.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
        <dependency id="UiPath.CefSharpBundle" version="1.8.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.FormActivityLibrary" version="2.0.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.3.18" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="H.Pipes" version="2.0.35" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CodeAnalysis.CSharp.Scripting" version="3.8.0" exclude="Build,Analyzers" />
        <dependency id="ReflectionMagic" version="4.1.0" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel.Composition" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.IO.Abstractions" version="3.0.10" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.7.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
        <dependency id="UiPath.CefSharpBundle.NetCore" version="1.8.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.FormActivityLibrary" version="2.0.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.3.18" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>