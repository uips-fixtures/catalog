<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Cryptography.Activities</id>
    <version>1.4.1</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://docs.uipath.com/activities/docs/about-the-cryptography-activities-pack</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?web</iconUrl>
    <description>UiPath Cryptography Activities Pack</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Portable.BouncyCastle" version="1.8.8" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="System.Security.Cryptography.Cng" version="5.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0" />
    </dependencies>
  </metadata>
</package>