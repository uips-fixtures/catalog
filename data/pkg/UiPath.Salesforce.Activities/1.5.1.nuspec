<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Salesforce.Activities</id>
    <version>1.5.1</version>
    <title>UiPath.Salesforce.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-salesforce-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for Salesforce using Salesforce Lightning Platform API. These activities allow you to execute operations such as create, retrieve, update, and delete on Salesforce objects (including Standard and Custom objects), manage files, retrieve list views, create and execute Bulk API jobs, execute reports, execute search, execute Salesforce Object Query Language (SOQL) queries. A generic Lightning REST API activity lets you invoke any of the remaining APIs that are not implemented as native activities.</description>
    <releaseNotes>Bug Fixes

* The Project URL was directing to an incorrect link from Manage Packages - View Project Information.

For the full release notes, please visit https://activities.uipath.com/docs/release-notes-salesforce.</releaseNotes>
    <dependencies>
      <dependency id="Newtonsoft.Json" version="11.0.2" />
      <dependency id="UiPath.Platform" version="20.4.0" />
      <dependency id="UiPath.Telemetry.Client" version="1.2.20" />
      <dependency id="CsvHelper" version="2.13.5" />
      <dependency id="RestSharp" version="106.3.1" />
    </dependencies>
  </metadata>
</package>