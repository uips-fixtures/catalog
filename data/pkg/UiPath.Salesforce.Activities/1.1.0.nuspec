<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Salesforce.Activities</id>
    <version>1.1.0</version>
    <title>UiPath.Salesforce.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-salesforce-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>Automation activities for Salesforce using Salesforce Lightning Platform API. These activities allow you to execute operations such as Create, Retrieve, Update, and Delete on Salesforce objects (including Standard and Custom objects), manage Files in Salesforce, execute Reports, and execute Salesforce Object Query Language (SOQL) queries.</description>
    <releaseNotes>Bug Fixes

* The Project URL was directing to an incorrect link from Manage Packages - View Project Information.

For the full release notes, please visit https://activities.uipath.com/docs/release-notes-salesforce.</releaseNotes>
    <dependencies>
      <dependency id="Newtonsoft.Json" version="12.0.2" />
      <dependency id="RestSharp" version="106.3.1" />
    </dependencies>
  </metadata>
</package>