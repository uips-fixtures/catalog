<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Salesforce.Activities</id>
    <version>1.9.3-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-salesforce-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for Salesforce using Salesforce Lightning Platform API. These activities allow you to execute operations such as create, retrieve, update, and delete on Salesforce objects (including Standard and Custom objects), manage files, retrieve list views, create and execute Bulk API jobs, execute reports, execute search, execute Salesforce Object Query Language (SOQL) queries. A generic Lightning REST API activity lets you invoke any of the remaining APIs that are not implemented as native activities. Please refer to the link below for Studio version compatibility and support: https://www.uipath.com/legal/trust-and-security/legal-support/product-lifecycle.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="CsvHelper" version="16.0.0" exclude="Build,Analyzers" />
        <dependency id="RestSharp" version="108.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="CsvHelper" version="16.0.0" exclude="Build,Analyzers" />
        <dependency id="RestSharp" version="108.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net6.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework=".NETFramework4.6.1" />
    </frameworkReferences>
  </metadata>
</package>