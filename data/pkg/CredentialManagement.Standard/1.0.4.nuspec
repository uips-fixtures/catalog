<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>CredentialManagement.Standard</id>
    <version>1.0.4</version>
    <authors>iLya Lozovyy (upgraded by Jason Allen)</authors>
    <owners>iLya Lozovyy (upgraded by Jason Allen)</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/jallen-aveva/credentialmanagement/blob/master/LICENSE</licenseUrl>
    <projectUrl>https://github.com/jallen-aveva/credentialmanagement</projectUrl>
    <description>Credential Management package is a wrapper for the Windows Credential Management API that supports both the old and the new style of UI</description>
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Drawing.Common" version="4.5.1" exclude="Build,Analyzers" />
        <dependency id="System.Security.Permissions" version="4.5.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>