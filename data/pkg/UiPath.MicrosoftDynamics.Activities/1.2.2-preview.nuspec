<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MicrosoftDynamics.Activities</id>
    <version>1.2.2-preview</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/microsoft-dynamics-365-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for Microsoft Dynamics 365 Customer Engagement using the Common Data Service Web API. These activities allow you to execute operations such as insert, update, get, delete and search on Microsoft Dynamics entities (including Standard and Custom entities), invoke functions and actions, and manage attachments.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.WebApi.Client" version="5.2.7" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client" version="4.48.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client.Broker" version="4.48.0-preview" exclude="Build,Analyzers" />
        <dependency id="MimeMapping" version="1.0.1.37" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.WebApi.Client" version="5.2.7" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client" version="4.48.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client.Broker" version="4.48.0-preview" exclude="Build,Analyzers" />
        <dependency id="MimeMapping" version="1.0.1.37" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>