<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MicrosoftDynamics.Activities</id>
    <version>1.0.0-preview</version>
    <title>UiPath.MicrosoftDynamics.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/integrations/docs/microsoft-dynamics-365-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for Microsoft Dynamics using the Dynamics 365 Customer Engagement Web API. These activities allow you to execute operations such as insert, update, get, delete and search on Microsoft Dynamics entities (including Standard and Custom entities), invoke functions and actions, and manage attachments.</description>
    <dependencies>
      <dependency id="ActiproSoftware.Wpf" version="18.1.6740" />
      <dependency id="Microsoft.ApplicationInsights" version="2.3.0" />
      <dependency id="System.ComponentModel.Annotations" version="4.6.0" />
      <dependency id="Microsoft.AspNet.WebApi.Client" version="5.2.7" />
      <dependency id="Microsoft.IdentityModel.Clients.ActiveDirectory" version="3.19.8" />
      <dependency id="Newtonsoft.Json" version="11.0.2" />
      <dependency id="System.Collections" version="4.3.0" />
    </dependencies>
  </metadata>
</package>