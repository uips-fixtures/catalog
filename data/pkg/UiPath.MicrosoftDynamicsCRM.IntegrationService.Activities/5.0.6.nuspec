<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MicrosoftDynamicsCRM.IntegrationService.Activities</id>
    <version>5.0.6</version>
    <title>Microsoft Dynamics CRM</title>
    <authors>UiPath</authors>
    <owners></owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-microsoft-dynamicscrm-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>[Deprecated] THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. UiPath Integration Service based automation activities for Microsoft Dynamics using the Dynamics 365 Customer Engagement Web API. These activities allow you to execute operations such as insert, update, get, delete and search on Microsoft Dynamics entities (including Standard and Custom entities).</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities CRM Dynamics Microsoft</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>