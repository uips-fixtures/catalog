<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Marketo.IntegrationService.Activities</id>
    <version>5.0.0</version>
    <title>Marketo</title>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-adobe-marketo-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. UiPath Integration Service based automation activities for Marketo. These activities allow you to execute create, retrieve, update, and delete operations on Marketo objects (including standard and custom objects).</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities Marketo ITIL ITAutomation Helpdesk</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>