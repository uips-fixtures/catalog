<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MicrosoftOffice365.Activities</id>
    <version>1.2.0</version>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/integrations/docs/microsoft-office-365-scope</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>A set of activities for interacting with Excel, Outlook, OneDrive, Sharepoint, and Planner from Microsoft Office 365.</description>
    <releaseNotes>Fixed issue with SendMail activity.</releaseNotes>
    <copyright>© 2019 UiPath</copyright>
    <tags>UiPath Microsoft Office 365 O365 Excel Outlook OneDrive Sharepoint Calendar Planner Groups Productivity Email Files Spreadsheets</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="BouncyCastle" version="1.8.2" exclude="Build,Analyzers" />
        <dependency id="ClosedXML" version="0.94.2" exclude="Build,Analyzers" />
        <dependency id="DocumentFormat.OpenXml" version="2.7.2" exclude="Build,Analyzers" />
        <dependency id="ExcelNumberFormat" version="1.0.3" exclude="Build,Analyzers" />
        <dependency id="FastMember" version="1.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Graph" version="1.12.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Graph.Core" version="1.12.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Client" version="2.7.1" exclude="Build,Analyzers" />
        <dependency id="MimeKit" version="2.1.3" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="10.0.3" exclude="Build,Analyzers" />
        <dependency id="System.IO.FileSystem.Primitives" version="4.0.1" exclude="Build,Analyzers" />
        <dependency id="System.IO.Packaging" version="4.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.5.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="PresentationCore" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="PresentationFramework" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Core.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Core" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xaml" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Xml" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="WindowsBase" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>