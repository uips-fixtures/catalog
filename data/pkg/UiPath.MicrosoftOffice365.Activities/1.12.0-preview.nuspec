    <projectUrl>https://docs.uipath.com/integrations/docs/microsoft-office-365-scope</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>A set of activities for interacting with Excel, Outlook, OneDrive, Sharepoint, and Planner from Microsoft Office 365.</description>
    <releaseNotes>https://docs.uipath.com/releasenotes/docs/uipath-microsoftoffice365-activities</releaseNotes>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities UiPath Microsoft Office 365 O365 Excel Outlook OneDrive Sharepoint Calendar Planner Groups Productivity Email Files Spreadsheets UiPathStudioX</tags>
