        <dependency id="Microsoft.Identity.Client" version="4.32.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Linq.Async.Queryable" version="5.0.0" exclude="Build,Analyzers" />
