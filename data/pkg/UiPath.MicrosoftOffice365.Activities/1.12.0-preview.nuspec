        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="System.Linq.Async.Queryable" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Activities.RuntimeGovernance" version="1.1.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.ConnectionClient" version="1.1.1" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="21.12.0-preview" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="ClosedXML" version="0.95.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="5.0.0" exclude="Build,Analyzers" />
