<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MicrosoftOffice365.Activities</id>
    <version>1.1.2</version>
    <title>UiPath.MicrosoftOffice365.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/integrations/docs/microsoft-office-365-scope</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>A set of activities for interacting with Excel, Outlook, OneDrive, and Sharepoint from Microsoft Office 365.</description>
    <releaseNotes>Localized in Simplified Chinese, Japanese, French, German, Korean, Portuguese, Brazilian Portuguese, Spanish, Latin American Spanish, Russian, and Turkish. Improved file search functions.</releaseNotes>
    <copyright>UiPath 2019</copyright>
    <tags>UiPath Microsoft Office 365 O365 Excel Outlook OneDrive Sharepoint Calendar Productivity Email Files Spreadsheets</tags>
    <dependencies>
      <dependency id="ClosedXML" version="0.94.2" />
      <dependency id="Microsoft.Graph" version="1.12.0" />
      <dependency id="MimeKit" version="2.1.3" />
      <dependency id="Newtonsoft.Json" version="10.0.3" />
      <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.5.1" />
      <dependency id="Microsoft.Identity.Client" version="2.7.1" />
    </dependencies>
  </metadata>
</package>