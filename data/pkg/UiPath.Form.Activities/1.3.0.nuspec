<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Form.Activities</id>
    <version>1.3.0</version>
    <title>UiPath.Form.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/form-activity</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Design and build forms and provide contextual guidance to users through callouts using a drag and drop interface, binding form/callout fields to workflow variables. The creation of a form/callout generates JSON schema that is used to display the same at runtime.</description>
    <tags>UiPathActivities</tags>
    <dependencies>
      <dependency id="System.Runtime.CompilerServices.Unsafe" version="4.5.2" />
      <dependency id="UiPath.FormActivityLibrary" version="1.3.0" />
      <dependency id="Castle.Core" version="4.3.1" />
      <dependency id="System.Threading.Tasks.Extensions" version="4.5.1" />
      <dependency id="System.IO.Abstractions" version="3.0.10" />
      <dependency id="UiPath.Telemetry.Client" version="1.3.18" />
    </dependencies>
  </metadata>
</package>