<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MLServices.Activities</id>
    <version>1.2.1</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?system</iconUrl>
    <description>IMPORTANT: This package version requires Studio 2019 LTS(2019.10) or above. The ML Skill activity won’t work on lower version. A set of activities allowing you to interact with AI Center. Retrieve and call all ML Skills available on your tenant by using ML Skill activity.</description>
    <copyright>@ 2021 UiPath</copyright>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="Newtonsoft.Json" version="11.0.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.5.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>