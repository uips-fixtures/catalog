        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="2.1.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="2.1.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
        <dependency id="UiPath.Platform" version="22.4.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="2.1.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>