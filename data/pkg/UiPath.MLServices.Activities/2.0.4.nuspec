<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.MLServices.Activities</id>
    <version>2.0.4</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?system</iconUrl>
    <description>IMPORTANT: This package version requires Studio 22.4 or above. A set of activities allowing you to interact with AI Center. Retrieve and call all ML Skills available on your tenant by using ML Skill activity.</description>
    <copyright>@ 2024 UiPath</copyright>
    <repository type="git" commit="edde8243371a504026c99274e83b9a84478ea47f" />
    <dependencies>
