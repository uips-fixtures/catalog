<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.ConfluenceCloud.IntegrationService.Activities</id>
    <version>5.0.0-preview</version>
    <title>Confluence Cloud</title>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/uipath-atlassian-confluence-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>THIS VERSION REQUIRES THE AUTOMATION CLOUD INTEGRATION SERVICE. Confluence is a web-based corporate wiki, Their APIs exposer are the primary way to get and modify data in Confluence Cloud and used to interact with Confluence entities, like pages and blog posts, spaces, users, groups, and more.</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities confluence atlassian</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0-windows7.0">
        <dependency id="UiPath.ConnectionClient" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="UiPath.IntegrationService.Infrastructure" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>