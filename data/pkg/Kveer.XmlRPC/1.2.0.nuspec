<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Kveer.XmlRPC</id>
    <version>1.2.0</version>
    <authors>Sébastien Rault</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/LordVeovis/xmlrpc</projectUrl>
    <description>A port of CookComputing.XmlRpcV2 for dotnet core.</description>
    <releaseNotes>- switch to circle-ci
- assembly has now a strong name
- upgrade compiler to .net 3.1 as 2.1 is out of support (still .netstandard2.0 compliant)</releaseNotes>
    <copyright>Sébastien Rault</copyright>
    <tags>xmlrpc</tags>
    <repository type="git" url="git@github.com:LordVeovis/xmlrpc.git" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Reflection.Emit" version="4.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>