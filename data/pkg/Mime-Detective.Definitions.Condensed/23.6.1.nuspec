<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Mime-Detective.Definitions.Condensed</id>
    <version>23.6.1</version>
    <authors>Tony Valenti, Joshua Clark, Max Vasilyev, Neil Harvey</authors>
    <license type="file">LICENSE.txt</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>noun_data search_4033516.png</icon>
    <projectUrl>https://github.com/MediatedCommunications/Mime-Detective</projectUrl>
    <description>A condensed library of +100 common file signatures for use by the "Mime-Detective" package.</description>
    <releaseNotes>For use with the "Mime-Detective" package.</releaseNotes>
    <tags>Magic Numbers Words File Format Media Header Signature Type Detection Map Convert Extension Mime Type</tags>
    <repository type="git" url="https://github.com/MediatedCommunications/Mime-Detective.git" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Mime-Detective" version="23.6.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Mime-Detective" version="23.6.1" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="6.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>