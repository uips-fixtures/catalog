<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.AmazonWorkSpaces.Activities</id>
    <version>1.0.0</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/activities/docs/about-the-amazon-workspaces-activities-pack</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Amazon WorkSpaces Activities Pack</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="AWSSDK.WorkDocs" version="3.5.0.69" exclude="Build,Analyzers" />
        <dependency id="AWSSDK.WorkSpaces" version="3.5.3.17" exclude="Build,Analyzers" />
        <dependency id="Polly" version="7.2.1" exclude="Build,Analyzers" />
        <dependency id="Polly.Contrib.WaitAndRetry" version="1.1.1" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel.Annotations" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="UiPath.Telemetry.Client" version="1.3.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Activities" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Activities.Presentation" targetFramework=".NETFramework4.6.1" />
      <frameworkAssembly assemblyName="System.Data.DataSetExtensions" targetFramework=".NETFramework4.6.1" />
    </frameworkAssemblies>
  </metadata>
</package>