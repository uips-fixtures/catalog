      <dependency id="Newtonsoft.Json" version="8.0.3" />
      <dependency id="System.ValueTuple" version="4.4.0" />
      <dependency id="Metrics.NET" version="0.5.5" />
      <dependency id="AForge.Imaging" version="2.2.5" />
      <dependency id="AForge.Neuro" version="2.2.5" />
      <dependency id="BitMiracle.Docotic.Pdf" version="5.2.8369" />
      <dependency id="CsvHelper" version="2.13.5" />
      <dependency id="MathNet.Numerics" version="4.5.1" />
      <dependency id="IvanAkcheurov.NTextCat.Lib" version="0.2.1.1" />
      <dependency id="Numsense" version="0.12.0" />
    </dependencies>
  </metadata>
</package>