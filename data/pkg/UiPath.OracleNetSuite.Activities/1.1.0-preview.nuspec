<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.OracleNetSuite.Activities</id>
    <version>1.1.0-preview</version>
    <title>UiPath.OracleNetSuite.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_MSSA.pdf</licenseUrl>
    <projectUrl>https://docs.uipath.com/integrations/docs/oracle-netsuite-about</projectUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png</iconUrl>
    <description>Automation activities for Oracle NetSuite using the SuiteTalk Web Services. These activities allow you to execute operations such as create, initialize, retrieve, update, and delete on Oracle NetSuite objects (including standard and custom objects) and manage files in the file cabinet.</description>
    <dependencies>
      <dependency id="DotNetProjects.WpfToolkit.Input" version="6.0.79" />
      <dependency id="Newtonsoft.Json" version="11.0.2" />
      <dependency id="System.ComponentModel.Annotations" version="4.6.0" />
      <dependency id="UiPath.Platform" version="20.4.0" />
      <dependency id="UiPath.Telemetry.Client" version="1.2.20" />
      <dependency id="System.Collections" version="4.3.0" />
    </dependencies>
  </metadata>
</package>