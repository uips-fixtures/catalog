        <dependency id="System.Xml.XmlDocument" version="4.0.1-beta-23516" />
        <dependency id="System.ServiceModel.Primitives" version="4.0.0" />
        <dependency id="System.ComponentModel.TypeConverter" version="4.0.1-beta-23516" />
        <dependency id="System.Data.Common" version="4.0.1-beta-23516" />
        <dependency id="System.Net.Requests" version="4.0.10" />
        <dependency id="System.Threading.ThreadPool" version="4.0.10-beta-23516" />
        <dependency id="System.Threading.Thread" version="4.0.0-beta-23516" />
        <dependency id="System.IO.Compression" version="4.0.1-beta-23409" />
        <dependency id="Microsoft.Extensions.PlatformAbstractions" version="1.0.0-rc1-final" />
        <dependency id="System.Threading.Timer" version="4.0.1-beta-23516" />
        <dependency id="System.Reflection.TypeExtensions" version="4.1.0-beta-23516" />
        <dependency id="System.IO.FileSystem.Watcher" version="4.0.0-beta-23225" />
      </group>
      <group targetFramework="Silverlight4.0" />
      <group targetFramework="Silverlight5.0" />
      <group targetFramework="WindowsPhone8.0" />
    </dependencies>
