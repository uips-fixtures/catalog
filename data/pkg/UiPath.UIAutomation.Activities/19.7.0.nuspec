<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.UIAutomation.Activities</id>
    <version>19.7.0</version>
    <title>UiPath.UIAutomation.Activities</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://www.uipath.com/hubfs/legalspot/UiPath_EULA.pdf</licenseUrl>
    <projectUrl>https://activities.uipath.com/docs/about-the-ui-automation-activities-pack</projectUrl>
    <iconUrl>http://www.uipath.com/favicon.ico</iconUrl>
    <description>IMPORTANT: This package version requires Studio v2018.4.4 / v2019.2 or above. Installing it on versions lower than the recommended ones may cause unexpected changes in your workflows.
Core activities which enable the robots to simulate human interaction such as mouse, keystrokes and image recognition. Package also contains activities for event monitoring, image, browser and window manipulation.</description>
    <releaseNotes>New Features and Improvements

This patch brings the **Chinese** language to the group of officially supported languages in UiPath for versions 19.7 and above.

Also, scraping can now be performed by using the entire suite of OCR engines supported by the UiPath Platform.</releaseNotes>
    <dependencies>
      <dependency id="UiPath" version="19.7.7128.27029" />
      <dependency id="UiPath.Vision" version="1.6.1" />
      <dependency id="UiPath.OCR.Contracts" version="2.0.0" />
      <dependency id="AvalonEdit" version="5.0.3" />
      <dependency id="Extended.Wpf.Toolkit" version="2.8.0" />
      <dependency id="Humanizer.Core" version="2.4.2" />
    </dependencies>
  </metadata>
</package>