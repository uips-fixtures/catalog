<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Database.Activities</id>
    <version>1.7.1</version>
    <authors>UiPath</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://github.com/UiPath/Community.Activities/tree/develop/Activities/Database/Licenses</licenseUrl>
    <iconUrl>https://download.uipath.com/UI_icon.png?web</iconUrl>
    <description>UiPath Database Activities Pack</description>
    <copyright>© UiPath</copyright>
    <tags>UiPathActivities</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Microsoft.Data.SqlClient" version="4.1.0" exclude="Build,Analyzers" />
        <dependency id="Oracle.ManagedDataAccess" version="19.11.0" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="5.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0-windows7.0">
        <dependency id="Microsoft.Data.SqlClient" version="4.1.0" exclude="Build,Analyzers" />
        <dependency id="Oracle.ManagedDataAccess.Core" version="3.21.1" exclude="Build,Analyzers" />
        <dependency id="System.Data.Odbc" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Data.OleDb" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Resources.Extensions" version="5.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>